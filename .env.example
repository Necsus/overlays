# Active ou désactive la connexion Twitch (laisser désactivée en développement local)
TWITCH_ENABLED=false

# Remplacer les valeurs factices dans le `.env` local uniquement.
# Garder exclusivement ces placeholders dans le modèle commité.
# Application créée dans la console développeur Twitch
TWITCH_CLIENT_ID=fake_client_id
TWITCH_CLIENT_SECRET=fake_client_secret

# Remplacer les identifiants factices dans `.env` si Twitch est activé.
# Identifiants numériques globaux du bot
TWITCH_BOT_ID=111111111
TWITCH_OWNER_ID=111111111

# Remplacer par le login réel du bot si Twitch est activé.
# Login du bot en minuscules, sans @
TWITCH_BOT_LOGIN=ma_chaine

# Authentification Twitch de l'administration web
# Pour la dev, remplacer cette URL dans `.env` par le callback local enregistré
# dans Twitch. Dans le `.env` du Geekom, utiliser le callback de release ci-dessous.
# https://overlays.necsus.dev/auth/twitch/callback.
TWITCH_ADMIN_REDIRECT_URI=https://devbox.example.ts.net/auth/twitch/callback
# Remplacer par un secret aléatoire unique dans chaque `.env`, jamais ici.
SESSION_SECRET=replace_with_a_long_random_secret
# Garder false en HTTP local ; mettre true dans le `.env` de release sous HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800

# Commandes du giveaway
TWITCH_COMMAND_PREFIX=!

# Connexion PostgreSQL de l'application lancée localement.
# Vérifier/remplacer si l'IP LAN du Geekom change ; à l'extérieur, utiliser son IP/nom Tailscale.
# Sur le Geekom, Compose remplace ces valeurs par l'adresse du service `db`
# et les identifiants de la base de release.
PSQL_HOST=192.168.1.112
PSQL_PORT=5432
# Valeurs du poste dev ; dans le `.env` du Geekom, utiliser overlays/overlays_release.
PSQL_DB=overlays_dev
PSQL_USER=overlays_dev
# Remplacer le mot de passe factice par celui du rôle créé sur PostgreSQL.
PSQL_PASSWORD=fake_dev_db_password
# Après configuration TLS côté PostgreSQL, préférer verify-full avec sa CA.
PSQL_SSLMODE=prefer

# Geekom uniquement : tag sha-<commit> immuable publié sur GHCR.
# Exemple fictif ; remplacer par le commit réellement choisi pour le déploiement.
OVERLAYS_IMAGE_TAG=sha-0000000000000000000000000000000000000000

# Geekom uniquement : choisir le compte avant le premier démarrage du volume PG.
# Les changer après initialisation ne modifie pas le compte déjà créé.
POSTGRES_ADMIN_USER=overlays_admin
# Remplacer ce placeholder par un mot de passe unique dans le `.env` du Geekom.
POSTGRES_ADMIN_PASSWORD=replace_with_a_long_random_secret

# Geekom uniquement : remplacer l'exemple par `tailscale ip -4` sur le serveur.
TAILSCALE_IPV4=100.64.0.1
